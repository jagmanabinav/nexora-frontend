{
  "name": "nexora-frontend",
  "version": "1.0.0",
  "description": "Nexora multi-app monorepo frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @nexora/shared build",
    "build:admin": "pnpm --filter admin build",
    "build:fabwash": "pnpm --filter fabwash build",
    "lint": "pnpm -r lint",
    "type-check": "pnpm -r type-check",
    "format": "prettier --write \"packages/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,json,css,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react-hooks": "5.0.0-canary-7118f5dd7-20230705",
    "prettier": "^3.0.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "zod": "^3.22.0"
  }
}
